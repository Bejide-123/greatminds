// Great Minds International School — Results MVP schema
// PostgreSQL + Prisma

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Enums ─────────────────────────

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum Sex {
  MALE
  FEMALE
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
}

enum TeacherStatus {
  ACTIVE
  INACTIVE
}

enum TermName {
  FIRST
  SECOND
  THIRD
}

// DRAFT -> SUBMITTED -> UNDER_REVIEW -> APPROVED / REJECTED -> PUBLISHED
// REJECTED -> teacher corrects -> SUBMITTED again
enum ResultStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PUBLISHED
}

// ───────────────────────── Auth ─────────────────────────
// ids are cuid strings (not 1,2,3...) so URLs/requests can't be
// guessed by counting up — helps against IDOR.

model User {
  id                 String   @id @default(cuid())
  username           String   @unique // student: admission no. | teacher: email | admin: email
  passwordHash       String // NEVER store plain text
  role               Role
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  student         Student?
  teacher         Teacher?
  reviewedResults Result[] @relation("ResultReviewer")
}

// ───────────────────────── School structure ─────────────────────────

model SchoolClass {
  id        String @id @default(cuid())
  name      String @unique // e.g. "Grade 1" — must match the Google Form dropdown exactly
  sortOrder Int    @default(0) // for ordering and, later, promotion

  students Student[]
  teachers Teacher[]
  results  Result[]
}

model AcademicSession {
  id        String  @id @default(cuid())
  name      String  @unique // "2026/2027"
  isCurrent Boolean @default(false)

  terms Term[]
}

model Term {
  id             String          @id @default(cuid())
  sessionId      String
  session        AcademicSession @relation(fields: [sessionId], references: [id])
  name           TermName
  nextTermBegins DateTime?       @db.Date // printed on the report card
  isCurrent      Boolean         @default(false)

  results Result[]

  @@unique([sessionId, name])
}

model Subject {
  id           String  @id @default(cuid())
  name         String  @unique
  code         String  @unique
  isCompulsory Boolean @default(false) // submit is blocked if a compulsory subject is missing
  isActive     Boolean @default(true)
  sortOrder    Int     @default(0) // report card shows subjects in a fixed order

  resultSubjects ResultSubject[]
}

// ───────────────────────── People ─────────────────────────

model Student {
  id              String        @id @default(cuid())
  userId          String?       @unique
  user            User?         @relation(fields: [userId], references: [id])
  admissionNumber String        @unique
  surname         String
  firstName       String
  otherName       String?
  sex             Sex
  dateOfBirth     DateTime      @db.Date
  classId         String // CURRENT class; changes when the student is promoted
  schoolClass     SchoolClass   @relation(fields: [classId], references: [id])
  status          StudentStatus @default(ACTIVE)

  // Guardian kept on the student for the MVP.
  // Split into its own table later if siblings/shared guardians matter.
  guardianName  String
  guardianPhone String // String, not Int — leading zero / +234
  guardianEmail String?

  // photoUrl String?  // later

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  results Result[]

  @@index([classId])
}

model Teacher {
  id          String        @id @default(cuid())
  userId      String?       @unique
  user        User?         @relation(fields: [userId], references: [id])
  staffId     String?       @unique // "Teacher ID" — only if the school uses one
  surname     String
  firstName   String
  otherName   String?
  email       String        @unique
  phone       String?
  classId     String
  schoolClass SchoolClass   @relation(fields: [classId], references: [id])
  status      TeacherStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  results Result[]

  @@index([classId])
}

// ───────────────────────── Results ─────────────────────────

// One student's result for ONE term (term -> session, so no separate sessionId).
model Result {
  id        String      @id @default(cuid())
  studentId String
  student   Student     @relation(fields: [studentId], references: [id])
  termId    String
  term      Term        @relation(fields: [termId], references: [id])

  // Class the student was in WHEN this result was entered.
  // Student.classId moves on after promotion; old results must not.
  classId     String
  schoolClass SchoolClass @relation(fields: [classId], references: [id])

  teacherId String // class teacher who entered it
  teacher   Teacher @relation(fields: [teacherId], references: [id])

  status          ResultStatus @default(DRAFT)
  rejectionReason String?
  submittedAt     DateTime?
  reviewedAt      DateTime?
  publishedAt     DateTime?
  reviewedById    String?
  reviewedBy      User?        @relation("ResultReviewer", fields: [reviewedById], references: [id])

  // Later (not blocking the MVP): attendance, affective/psychomotor skills,
  // General remarks for the student's overall performance
  teacherRemark     String?
  headTeacherRemark String?
  psychomotor Json?

  overallAverage Decimal? @db.Decimal(5, 2)
  classPosition  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subjects ResultSubject[]

  @@unique([studentId, termId]) // one result per student per term
  @@index([classId, termId, status])
}

model ResultSubject {
  id        String  @id @default(cuid())
  resultId  String
  result    Result  @relation(fields: [resultId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  // Nullable so a DRAFT can be saved half-filled.
  // Submit validation requires both CA and Exam for every row.
  caScore    Decimal? @db.Decimal(5, 2) // 0–40
  examScore  Decimal? @db.Decimal(5, 2) // 0–60
  totalScore Decimal? @db.Decimal(5, 2) // calculated on the server: CA + Exam. Never typed in.
  grade      String? // calculated from the school's grading scale (pending)
  remark     String?

  // Free text on purpose: part-time teachers (e.g. French) have no portal account.
  subjectTeacherName String?

  @@unique([resultId, subjectId])
  // Add in a migration (Prisma can't express these yet):
  //   CHECK ("caScore"   BETWEEN 0 AND 40)
  //   CHECK ("examScore" BETWEEN 0 AND 60)
}
